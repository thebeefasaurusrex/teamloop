{
  "schemaVersion": 1,
  "git": "git",
  "standardPolicyVersion": "1.0.0",
  "stateRoot": "../.teamloop/private",
  "blockedLiterals": ["excluded@example.test"],
  "limits": {
    "maxTaskTimeoutMs": 180000,
    "maxRunsPerProviderPacket": 1
  },
  "codex": "codex",
  "codexHome": "./replace-with-dedicated-codex-home",
  "claude": "claude",
  "claudeUsageCreditsOff": false,
  "billingCheckedAt": null,
  "claudePlanAttested": null,
  "antigravity": "agy",
  "antigravityHome": "./replace-with-os-user-antigravity-cli-directory",
  "antigravityFileLoginCompatibility": false,
  "allowApiSpend": false,
  "nvidiaKeyFile": "./replace-with-private-key-file",
  "executionModes": {
    "claude-bridge": {
      "enabled": false,
      "provider": "claude",
      "builderVersion": "1.0.3",
      "validatedBuilderVersion": "1.0.3"
    }
  },
  "claudeBridge": {
    "model": "sonnet",
    "effort": "high",
    "allowedAuxiliaryModels": [],
    "allowedAccounts": [],
    "allowedPlanAttestations": ["max-5x", "max-20x"],
    "verificationExecutables": ["node"]
  },
  "providers": {
    "codex": {
      "enabled": false,
      "allowedAccounts": [],
      "models": {
        "gpt-6.1-sol": {
          "efforts": ["medium", "high"],
          "imageInput": false
        }
      }
    },
    "claude": {
      "enabled": false,
      "allowedAccounts": [],
      "models": {
        "claude-sonnet-5-5": {
          "efforts": ["high"],
          "imageInput": false,
          "resolvedModels": ["claude-sonnet-5-5"]
        },
        "claude-opus-5-5": {
          "efforts": ["high"],
          "imageInput": false,
          "resolvedModels": ["claude-opus-5-5"]
        }
      }
    },
    "gemini": {
      "enabled": false,
      "allowedAccounts": [],
      "models": {}
    },
    "nvidia": {
      "enabled": false,
      "models": {}
    }
  },
  "claudeDesign": {
    "enabled": false,
    "model": "claude-opus-5-5",
    "effort": "high",
    "timeoutMs": 2700000,
    "allowedAccounts": [],
    "allowedPlanAttestations": ["max-5x"],
    "verificationExecutables": ["node"]
  }
}
